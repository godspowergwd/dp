# =============================================================================
# PLACEHOLDER ONLY — copy to .env and fill with real values. Never commit .env.
# See docs/14-DEPLOYMENT-ENVIRONMENT.md for the full list.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=4000

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dropshipping_os

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-random-64-hex-char-string

# Encryption for stored integration credentials
ENCRYPTION_KEY=change-me-generate-a-random-32-byte-key

# --- AI providers (server-side only) ---
# AI_PRIMARY_PROVIDER_KEY=
# AI_BULK_PROVIDER_KEY=
# AI_IMAGE_PROVIDER_KEY=

# --- Store provider keys (server-side only) ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SHOP_DOMAIN=

# --- Supplier provider keys (server-side only) ---
# SUPPLIER_ALIEXPRESS_API_KEY=
