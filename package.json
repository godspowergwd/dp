{
  "name": "private-dropshipping-os",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-operator dropshipping operating system (monorepo).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @pd/api",
    "dev:web": "npm run dev -w @pd/web",
    "db:migrate": "npm run db:migrate -w @pd/api",
    "db:generate": "npm run db:generate -w @pd/api",
    "db:seed": "npm run db:seed -w @pd/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "eslint-plugin-react": "^7.35.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}

