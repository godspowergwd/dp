# =============================================================================
# Copy to apps/api/.env and fill in real values. Never commit real secrets.
# Root .env.example is the top-level reference; this file is the runtime copy.
# =============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=4000

# Hosted PostgreSQL (or local). Example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropshipping_os

# Generate: openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-random-64-hex-char-string

# Encryption key for stored integration credentials (32 bytes)
ENCRYPTION_KEY=change-me-generate-a-random-32-byte-key

# All provider keys go here (server-side only), e.g.:
# AI_PRIMARY_PROVIDER_KEY=
# SHOPIFY_API_KEY=
